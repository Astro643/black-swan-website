# ============================================
# BLACK SWAN WEBSITE - ENVIRONMENT VARIABLES
# ============================================

# -------------------------------------------
# SUPABASE CONFIGURATION
# -------------------------------------------

# Supabase Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL connection string (private)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# -------------------------------------------
# DISCORD OAUTH CONFIGURATION
# -------------------------------------------

# Discord OAuth Client ID (from Discord Developer Portal)
DISCORD_CLIENT_ID=your-discord-client-id

# Discord OAuth Client Secret (from Discord Developer Portal)
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Discord OAuth Redirect URI
# For local development: http://localhost:3000/auth/callback
# For production: https://your-domain.com/auth/callback
NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# -------------------------------------------
# ADMIN CONFIGURATION
# -------------------------------------------

# Discord Guild ID for admin checks
ADMIN_GUILD_ID=your-discord-guild-id

# Discord User ID of the admin (for fallback checks)
ADMIN_DISCORD_ID=your-discord-user-id

# -------------------------------------------
# APPLICATION CONFIGURATION
# -------------------------------------------

# Render external URL (auto-provided by Render)
# For local development, set to: http://localhost:3000
RENDER_EXTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_RENDER_EXTERNAL_URL=http://localhost:3000

# -------------------------------------------
# SUPABASE STORAGE CONFIGURATION
# -------------------------------------------

# Storage bucket names (optional, can be configured in code)
NEXT_PUBLIC_STORAGE_BUCKET_SHOP_ASSETS=shop-assets
NEXT_PUBLIC_STORAGE_BUCKET_PROFILE_PICTURES=profile-pictures
NEXT_PUBLIC_STORAGE_BUCKET_COSMETICS=cosmetics

# -------------------------------------------
# DEVELOPMENT CONFIGURATION
# -------------------------------------------

# Development mode (set to 'true' for local development)
NEXT_PUBLIC_DEV_MODE=false

# Log level (debug, info, warn, error)
NEXT_PUBLIC_LOG_LEVEL=info

# -------------------------------------------
# RATE LIMITING CONFIGURATION
# -------------------------------------------

# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# -------------------------------------------
# CACHE CONFIGURATION
# -------------------------------------------

# Cache TTL for stocks in seconds (default: 5)
CACHE_STOCKS_TTL=5

# Cache TTL for portfolio in seconds (default: 10)
CACHE_PORTFOLIO_TTL=10

# Cache TTL for leaderboard in seconds (default: 30)
CACHE_LEADERBOARD_TTL=30

# ============================================
# NOTES
# ============================================

# 1. All variables prefixed with NEXT_PUBLIC_ are exposed to the client-side
# 2. Sensitive variables (DATABASE_URL, secrets) should NOT be prefixed
# 3. For production, set these variables in Render dashboard
# 4. Supabase Edge Functions use their own environment variables
# 5. Discord OAuth requires 'identify' and 'guilds' scopes

# ============================================
# SUPABASE EDGE FUNCTIONS
# ============================================

# These are configured in Supabase dashboard separately:
# - loan-interest: Runs every hour
# - wealth-tax: Runs at midnight UTC
# - market-sync: Runs every 5 minutes

# Required for Edge Functions:
# SUPABASE_URL (same as above)
# SUPABASE_SERVICE_ROLE_KEY (from Supabase project settings)
